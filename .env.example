# Required in production. Use a long random string.
SESSION_SECRET=replace-with-at-least-16-characters

# SQLite file. Use /data/folio.db when a disk is mounted in Docker.
DATABASE_PATH=data/folio.db

# Set true behind HTTPS so the session cookie is marked Secure.
# Leave unset or false for `npm run dev` and local http://localhost.
COOKIE_SECURE=false
